rules_version = '2';

// Security rules for sharing steps with friends.
// Paste these into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Friend code -> user id. Anyone signed in can look up a code;
    // a code can be claimed once and never changed or taken over.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && code.size() == 6;
    }

    // Each person's daily summary. Only they can write it, and only they
    // and the friends they added (the "readers" list, at most 3) can read it.
    match /users/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || request.auth.uid in resource.data.readers);
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.readers.size() <= 3;
    }
  }
}
