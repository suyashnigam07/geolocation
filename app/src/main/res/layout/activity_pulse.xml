<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:id="@+id/pulse_caption"
        android:text="Heart rate"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:id="@+id/pulse_title"
        android:text="Pulse rate"
        android:textColor="@color/text_primary"
        android:textSize="28sp" />

    <LinearLayout
        style="@style/Card"
        android:gravity="center_horizontal"
        android:paddingTop="28dp">

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="200dp">

            <com.simple.pedometer.HeartView
                android:id="@+id/heart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="44sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BPM"
                    android:textColor="@color/heart"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:minLines="2"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <com.simple.pedometer.PulseWaveView
            android:id="@+id/wave"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pulse_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Rest your fingertip lightly over the back camera and flash, without pressing hard, and stay still for about 20 seconds. This is an estimate for personal use, not a medical device."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
</LinearLayout>
