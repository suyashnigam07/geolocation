<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101215">

    <!-- Friend's video, full screen -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Your own camera, small in the corner -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/local_video"
        android:layout_width="108dp"
        android:layout_height="152dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="44dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/call_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="#DDFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Controls during a call -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/call_mic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_call_button"
            android:contentDescription="Mute microphone"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/call_camera"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_call_button"
            android:contentDescription="Turn camera off"
            android:src="@drawable/ic_videocam" />

        <ImageButton
            android:id="@+id/call_switch"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_call_button"
            android:contentDescription="Switch camera"
            android:src="@drawable/ic_switch_camera" />

        <ImageButton
            android:id="@+id/call_hangup"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_call_end_button"
            android:contentDescription="End call"
            android:src="@drawable/ic_call_end" />
    </LinearLayout>

    <!-- Incoming call: decline / accept -->
    <LinearLayout
        android:id="@+id/call_incoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/call_decline"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="96dp"
            android:background="@drawable/bg_call_end_button"
            android:contentDescription="Decline"
            android:src="@drawable/ic_call_end" />

        <ImageButton
            android:id="@+id/call_accept"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_call_accept_button"
            android:contentDescription="Accept"
            android:src="@drawable/ic_call" />
    </LinearLayout>
</FrameLayout>
